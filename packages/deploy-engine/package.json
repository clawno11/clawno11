{
  "name": "@clawno/deploy-engine",
  "version": "0.1.0",
  "description": "Local and SSH remote deployment engine for OpenClaw",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",

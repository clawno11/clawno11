# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
.next
out
target

# Turbo
.turbo

# Environment
.env
.env.local
.env.*.local
# Production secrets — never commit
.env.production
.env.production.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Expo / React Native
.expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build

# Tauri
apps/desktop/src-tauri/target
apps/mobile/src-tauri/target

# Android build outputs (generated, not committed)
apps/mobile/src-tauri/gen/android/app/build/
apps/mobile/src-tauri/gen/android/build/
apps/mobile/src-tauri/gen/android/.gradle/
apps/mobile/src-tauri/gen/android/buildSrc/.gradle/
apps/mobile/src-tauri/gen/android/buildSrc/build/
apps/mobile/src-tauri/gen/android/buildSrc/.kotlin/

# Android generated assets & native libs (Tauri auto-generates these on build)
apps/mobile/src-tauri/gen/android/app/src/main/assets/
apps/mobile/src-tauri/gen/android/app/src/main/jniLibs/

# Android signing secrets (NEVER commit these)
apps/mobile/src-tauri/gen/android/keystore.properties
apps/mobile/src-tauri/gen/android/*.keystore
apps/mobile/src-tauri/gen/android/*.jks

# Vite dist
apps/mobile/dist/
apps/desktop/dist/

# APK build artifacts
_apk_extract/
_apk_x86_64.zip
_apk_x86_64_out/

# Android/iOS bug reports
bugreport-*.zip
apps/mobile/bugreport-*.zip

# Compiled JS artifacts in src (tsc noEmit should prevent these, but just in case)
apps/mobile/src/**/*.js
apps/mobile/src/**/*.js.map
apps/mobile/vite.config.js

# Rust incremental compilation & dep-info (should be covered by `target` above,
# but explicit patterns ensure coverage on all platforms)
**/*.d
**/incremental/

# TOFU SSH known hosts (user data, not project config)
.clawno11/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawNo.11",
  "version": "1.0.0",
  "identifier": "ai.clawno11.mobile",
  "build": {
    "beforeDevCommand": "pnpm --filter @clawno/openclaw-client build && pnpm --filter @clawno/mobile run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --filter @clawno/openclaw-client build && pnpm --filter @clawno/mobile run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClawNo.11",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "YOUR_TEAM_ID",
      "bundleVersion": "12"
    }
  },
  "plugins": {}
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawNo.11",
  "version": "0.1.0",
  "identifier": "ai.clawno11.mobile",
  "build": {
    "beforeDevCommand": "pnpm --filter @clawno/openclaw-client build && pnpm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --filter @clawno/openclaw-client build && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://* https://* ws://* wss://*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "YOUR_TEAM_ID",
      "bundleVersion": "1"
    }
  },
  "plugins": {}
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawNo.11",
  "version": "26.3.23",
  "identifier": "ai.clawno11.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClawNo.11 — You × AI = ∞",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://open.bigmodel.cn https://openrouter.ai https://api.anthropic.com https://api.openai.com https://api.minimaxi.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "Developer ID Application: shiyi yan (R4F6WVNKS8)",
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/clawno11/clawno11/releases/latest/download/latest.json"
      ],
      "pubkey": "RWSH6VkdQJO9dWWx2aE9IGPlgY7VIX69sRihFaO59lSmCuzv9XGue12H"
    }
  }
}
